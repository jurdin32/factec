# Modelo de archivo de entorno para los servicios (cópielo como <proyecto>/.env).
#
# Los servicios de systemd lo cargan con EnvironmentFile, apuntando a la carpeta del proyecto: ahí
# van las variables que no quiere tener escritas en el código (y que no sube al
# repositorio). Este archivo es opcional: si no existe, se usan los ajustes de
# settings.py.

# Clave con la que el paquete cifra la contraseña del .p12 (SRI_CLAVE_CIFRADO).
# Genérela con:
#   python -c "from factec.django.crypto import generar_clave; print(generar_clave())"
# Si no la define aquí, tiene que estar en FACTURACION_ELECTRONICA.
SRI_CLAVE_CIFRADO=

# Dónde está el broker de Celery. Si usa esta variable, en settings.py puede
# poner:  CELERY_BROKER_URL = os.environ.get("CELERY_BROKER_URL", "redis://localhost:6379/0")
# Con contraseña:  redis://:la-clave@127.0.0.1:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Ambiente del SRI por si quiere forzarlo desde fuera (1 pruebas, 2 producción).
# SRI_AMBIENTE=pruebas

# A quién avisar si la firma electrónica va a vencer (separados por comas).
# FACTURACION_ELECTRONICA["CORREOS_AVISO"] / variable del proceso:
# SRI_CORREOS_AVISO=
